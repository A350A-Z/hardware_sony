//HIDL to AIDL(2026.8.28)

soong_config_module_type {
    name: "sony_powershare_hal_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "SONY_POWERSHARE",
    value_variables: ["WIRELESS_TX_ENABLE_PATH"],
    properties: ["cppflags"],
}

sony_powershare_hal_cc_defaults {
    name: "sony_powershare_hal_defaults",
    soong_config_variables: {
        WIRELESS_TX_ENABLE_PATH: {
            cppflags: ["-DWIRELESS_TX_ENABLE_PATH=\"%s\""],
        },
    },
}

cc_library_headers {
    name: "sony_powershare_hal_headers",
    vendor_available: true,
    export_include_dirs: ["include"],
}

cc_binary {
    name: "vendor.lineage.powershare-service.sony",
    defaults: [
        "sony_powershare_hal_defaults",
    ],
    init_rc: ["vendor.lineage.powershare-service.sony.rc"],
    vintf_fragments: ["vendor.lineage.powershare-service.sony.xml"],
    relative_install_path: "hw",
    srcs: [
        "PowerShare.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.lineage.powershare-V1-ndk",
    ],
    header_libs: [
        "sony_powershare_hal_headers",
    ],
    proprietary: true,
}
